[Unit]
Description=GigaAM speech-to-text for ceiling-bot (socket)

[Socket]
ListenStream=/run/ceiling-bot-stt.sock
# Один процесс ceiling-bot-stt.service на все подключения (Accept=no): модель грузится один раз, запросы —
# по одному, лишние ждут в очереди сокета. Две модели в памяти одновременно не бывают.
Accept=no
Backlog=16
# Бот — DynamicUser без постоянного uid, поэтому права на сокет открыты; процесс-обработчик без сети.
SocketMode=0666

[Install]
WantedBy=sockets.target
