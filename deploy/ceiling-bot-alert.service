[Unit]
Description=Alert: ceiling-bot stopped after too many failures

[Service]
Type=oneshot
WorkingDirectory=/opt/ceiling-bot
ExecStart=/opt/ceiling-bot/.venv/bin/python -m app.ops.alert failed
EnvironmentFile=/etc/Solaris/ceiling-bot.env
Environment=DB_PATH=/var/lib/ceiling-bot/ceiling-bot.sqlite3
DynamicUser=yes
User=ceiling-bot
StateDirectory=ceiling-bot
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
