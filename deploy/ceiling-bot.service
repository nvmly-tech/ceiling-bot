[Unit]
Description=Ceiling studio lead bot (Telegram → Trello)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10
# systemd исчерпал лимит перезапусков — последний алерт.
OnFailure=ceiling-bot-alert.service

[Service]
# Бот сам сообщает о готовности (READY=1) и шлёт «жив» (WATCHDOG=1), только пока ядро здорово.
# Нет сигнала 60 с — systemd убивает процесс и перезапускает.
Type=notify
NotifyAccess=main
WatchdogSec=60
TimeoutStartSec=120
TimeoutStopSec=30
WorkingDirectory=/opt/ceiling-bot
ExecStart=/opt/ceiling-bot/.venv/bin/python -m app.main
# После каждой остановки: при аварийной (watchdog, ошибка, сигнал) — алерт с причиной, при штатной — тишина.
ExecStopPost=/opt/ceiling-bot/.venv/bin/python -m app.ops.alert stop
# Секреты: файл читает сам systemd (root), пользователю сервиса доступ к нему не нужен.
EnvironmentFile=/etc/Solaris/ceiling-bot.env
# DB_PATH не пишите в env-файл: EnvironmentFile перекрывает Environment.
Environment=DB_PATH=/var/lib/ceiling-bot/ceiling-bot.sqlite3
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# Автоперезапуск минует состояние failed: иначе OnFailure («systemd сдался») срабатывал бы при каждом падении.
# ExecStopPost (алерт с причиной) при этом вызывается.
RestartMode=direct

# Изоляция: временный пользователь без прав, писать можно только в /var/lib/ceiling-bot.
DynamicUser=yes
User=ceiling-bot
StateDirectory=ceiling-bot
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Никаких привилегий ядра, только нужные виды сокетов и системных вызовов.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
# AF_UNIX — journald и sd_notify, AF_INET/6 — API, AF_NETLINK — getaddrinfo (DNS).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target
