[Unit]
Description=Ceiling studio lead bot (Telegram → Trello)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/ceiling-bot
ExecStart=/opt/ceiling-bot/.venv/bin/python -m app.main
# Секреты: файл читает сам systemd (root), пользователю сервиса доступ к нему не нужен.
EnvironmentFile=/etc/Solaris/ceiling-bot.env
# DB_PATH не пишите в env-файл: EnvironmentFile перекрывает Environment.
Environment=DB_PATH=/var/lib/ceiling-bot/ceiling-bot.sqlite3
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

# Изоляция: временный пользователь без прав, писать можно только в /var/lib/ceiling-bot.
DynamicUser=yes
StateDirectory=ceiling-bot
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
