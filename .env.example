# Локальная разработка: скопировать в .env. На VPS — /etc/Solaris/ceiling-bot.env
BOT_TOKEN=123456:ABC-DEF
DB_PATH=data/ceiling-bot.sqlite3
STUDIO_TZ=Europe/Moscow
WORK_START=09:00
WORK_END=21:00
LOG_LEVEL=INFO

# Trello (этап 2). BOARD_ID — короткий код из адреса доски: trello.com/b/<BOARD_ID>/...
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Названия списков на доске (если нет — бот создаст)
TRELLO_LIST_NEW=Новые запросы
TRELLO_LIST_IN_WORK=В работе
# Этапы после «Взял в работу»: замер назначен (и «клиент думает»), договор, отказ
TRELLO_LIST_MEASURE=Замер
TRELLO_LIST_WON=Договор
TRELLO_LIST_LOST=Отказ

# Чат менеджеров для уведомлений: группа, куда добавлен бот
MANAGER_CHAT_ID=
ABANDON_AFTER_MIN=30
REMIND_AFTER_MIN=15
REMIND_MAX=3
CLIENT_MSG_DELAY_SEC=60

# Расшифровка голосовых: основная — GigaAM на этом же сервере (сервис ceiling-bot-stt, ставит deploy/stt/deploy_stt.sh).
# Пусто — GigaAM не используется, голосовые расшифровывает Groq.
GIGAAM_SOCKET=
GIGAAM_TIMEOUT_SEC=60
# Теневое сравнение: вторая модель тоже расшифровывает голосовое, текст — только в базу (отчёт: app/ops/stt_compare.py).
# Пока включено, голос уходит и в Groq; выключить (false), когда выбор модели сделан.
STT_SHADOW=true

# Groq: резервная расшифровка голосовых; тот же ключ — для резервной LLM (этап 5).
# Ключ: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=ru

# LLM (этап 5). Основная модель — DeepSeek через router.cheap (OpenAI-совместимый API).
# BASE_URL — адрес API из документации router.cheap (обычно заканчивается на /v1), MODEL — точное имя модели DeepSeek у них.
LLM_PRIMARY_NAME=deepseek (router.cheap)
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
# Резервная модель — на Groq, ключ и адрес берутся из GROQ_API_KEY / GROQ_BASE_URL.
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# Сколько секунд ждать ответа модели, прежде чем перейти к следующей (резервной, потом скрипт).
LLM_TIMEOUT_SEC=15

# Сторож (этап 6): чат, куда слать алерты «модель упала / бот перезапущен».
# Пусто — алерты уходят в чат менеджеров. Узнать свой id: написать @userinfobot.
ADMIN_CHAT_ID=
# Необязательно: внешний мониторинг (healthchecks.io и т.п.) — пинг раз в 5 минут, пока бот здоров.
HEALTHCHECK_URL=
